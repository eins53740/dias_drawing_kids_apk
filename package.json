{
  "name": "desenha-os-dias",
  "version": "1.0.0",
  "description": "Desenha os Dias - Kids drawing guide app for Família Dias",
  "main": "index.js",
  "scripts": {
    "start": "npx serve www",
    "cap:init": "npx cap init \"Desenha os Dias\" com.dias.desenha --web-dir www",
